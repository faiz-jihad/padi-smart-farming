APP_NAME=padi-ai-service
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api/v1

MODEL_PATH=models/YOLO11L-Rice-Disease-Detection.pt
MODEL_VERSION=yolo11l-rice-disease
MODEL_REPORTED_ACCURACY=
MODEL_CONFIDENCE_HIGH=0.85
MODEL_CONFIDENCE_MEDIUM=0.70
MODEL_CLASS_LABELS_PATH=models/class_labels.json

MAX_IMAGE_SIZE_MB=5
MIN_BLUR_SCORE=100
MIN_BRIGHTNESS=40
MAX_BRIGHTNESS=220

LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=15

WEATHER_API_KEY=
WEATHER_BASE_URL=
WEATHER_TIMEOUT_SECONDS=10

ALLOWED_ORIGINS=http://localhost:3000
