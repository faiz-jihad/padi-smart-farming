# P.A.D.I. AI Service — Environment Configuration
# Copy ke .env dan sesuaikan nilai-nilainya

# ── App ─────────────────────────────────────────────────────────────────────
APP_NAME=padi-ai-service
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api/v1

# ── Model ────────────────────────────────────────────────────────────────────
# Path ke model .pt (relatif dari ai-service/ atau absolut)
MODEL_PATH=models/padi.pt

# Nama dan versi model — digunakan untuk metadata & versioning
PADI_MODEL_NAME=paddy_doctor
PADI_MODEL_VERSION=v3

# Ukuran input gambar model (default 384)
MODEL_IMGSZ=384

# ── GPU Concurrency ──────────────────────────────────────────────────────────
# Jumlah request inference yang dapat berjalan bersamaan
# Naikan setelah load test. Default 1 untuk mencegah CUDA OOM.
PADI_MAX_GPU_CONCURRENCY=1

# ── Image Upload ─────────────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=10

# ── Image Quality Thresholds ─────────────────────────────────────────────────
# Blur: variance of Laplacian — semakin tinggi semakin tajam
QUALITY_BLUR_THRESHOLD=50
# Resolusi minimum
QUALITY_MIN_WIDTH=200
QUALITY_MIN_HEIGHT=200
# Brightness: mean grayscale 0-255
QUALITY_BRIGHTNESS_MIN=45
QUALITY_BRIGHTNESS_MAX=225

# ── Decision Engine Thresholds ───────────────────────────────────────────────
# HIGH_CONFIDENCE: confidence >= threshold + margin >= MIN_MARGIN + quality GOOD
HIGH_CONFIDENCE_THRESHOLD=0.85
# NEED_PPL_REVIEW: confidence >= threshold (di bawah high)
REVIEW_CONFIDENCE_THRESHOLD=0.60
# Margin minimum untuk HIGH_CONFIDENCE
MIN_MARGIN_THRESHOLD=0.20

# ── Multi-view (disabled by default) ─────────────────────────────────────────
PADI_ENABLE_MULTIVIEW=false

# ── Disease Catalog ───────────────────────────────────────────────────────────
DISEASE_CATALOG_PATH=data/disease_catalog.json

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list. Jangan gunakan * di production.
# Tambahkan IP laptop/emulator Android: http://192.168.x.x:PORT
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000,http://localhost:8002
